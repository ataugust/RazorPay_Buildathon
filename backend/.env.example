# deterministic (no external dependency), gemini, cloud, or ollama
ASC_LLM_PROVIDER=gemini
ASC_LLM_MODEL=gemini-3.5-flash
ASC_LLM_TIMEOUT_SECONDS=15

# Create this in Google AI Studio. Keep it only in backend/.env.
GEMINI_API_KEY=

# Cloud JSON/chat-completions compatible provider
ASC_LLM_ENDPOINT=
ASC_LLM_API_KEY=

# Local Ollama provider
ASC_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Razorpay Standard Checkout. Generate Test Mode keys in the Razorpay Dashboard first.
# Never expose RAZORPAY_KEY_SECRET to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
